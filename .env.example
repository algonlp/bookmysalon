PORT=8002
APP_ENV=dev
LOG_LEVEL=info
PUBLIC_SUPPORT_COMPANY_NAME=Algonlp
PUBLIC_SUPPORT_PLATFORM_NAME=QR Schedule
PUBLIC_GOOGLE_CLIENT_ID=
# Also supported:
# GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
CLIENT_PLATFORM_STORAGE=file
APP_TIMEZONE=UTC
DEFAULT_BUSINESS_CURRENCY_CODE=PKR
DEFAULT_BUSINESS_CURRENCY_LOCALE=en-PK
WAITLIST_OFFER_WINDOW_MINUTES=10

# Booking page launch/campaign banner (edit here to update it everywhere).
# Set PUBLIC_BOOKING_PROMO_ENABLED=false to hide the banner completely.
PUBLIC_BOOKING_PROMO_ENABLED=true
PUBLIC_BOOKING_PROMO_BADGE=✨ Launch offer
PUBLIC_BOOKING_PROMO_DISCOUNT=100% OFF
PUBLIC_BOOKING_PROMO_TITLE=This service is on us — completely free
PUBLIC_BOOKING_PROMO_COPY=To celebrate our launch, we're covering the full price of your booking. Reserve your slot now and pay nothing.
PUBLIC_BOOKING_PROMO_FREE_LABEL=FREE
TRUST_PROXY=false
PUBLIC_BASE_URL=
# Set this in deployed environments so QR codes, waitlist links, and dashboard launch links use your real domain.
CORS_ALLOWED_ORIGINS=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Also supported as fallbacks:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
ENABLE_PUBLIC_CUSTOMER_LOOKUPS=true
PUBLIC_PROFILE_FIELD_PHONE_LABEL=Business phone number
PUBLIC_PROFILE_FIELD_PHONE_PLACEHOLDER=+1234567890
PUBLIC_BOOKING_LOCATION_LABEL=Service location
PUBLIC_BOOKING_LOCATION_OPTION_PHYSICAL=Visit the salon
PUBLIC_BOOKING_LOCATION_OPTION_MOBILE=Barber comes to my home
PUBLIC_BOOKING_LOCATION_OPTION_VIRTUAL=Online service
PUBLIC_BOOKING_ADDRESS_LABEL=Home address
PUBLIC_BOOKING_ADDRESS_PLACEHOLDER=Enter your home address
PUBLIC_BOOKING_ADDRESS_HELP=Add the address where you want to receive the service.
PUBLIC_BOOKING_ADDRESS_REQUIRED=Home address is required when you choose at-home service.
PUBLIC_BOOKING_PHONE_LABEL=Phone number
PUBLIC_BOOKING_PHONE_HELP=You and the business will receive SMS updates on this number.
PUBLIC_BOOKING_PHONE_COUNTRY_CODE_LABEL=Country code
PUBLIC_BOOKING_PHONE_COUNTRY_CODE=
PUBLIC_BOOKING_PHONE_NUMBER_PLACEHOLDER=Enter phone number
PUBLIC_HOME_SEARCH_RESULTS_LIMIT=3
PLATFORM_ADMIN_COOKIE_NAME=platform_admin_session
ADMIN_SESSION_TTL_DAYS=3650
# ── Email OTP via Namecheap Private Email SMTP (recommended) ──
# Step 1: Use a dedicated mailbox (e.g. info@yourdomain.com) for system emails only
# Step 2: cPanel/webmail → generate an App Password for that mailbox
# Step 3: paste that app password as SMTP_PASS below (never the real login password)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@yourdomain.com
SMTP_PASS=
SMTP_FROM=QR Schedule <info@yourdomain.com>

# ── Email OTP via Gmail SMTP (alternative) ─────────────────────
# Step 1: Google Account → Security → enable 2-Step Verification
# Step 2: Google Account → Security → App Passwords → create one for "Mail"
# Step 3: paste that 16-character password as SMTP_PASS below
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=
# SMTP_FROM=QR Schedule <your@gmail.com>

# ── Email OTP via SendGrid (alternative) ─────────────────────
# Sign up at sendgrid.com → Settings → API Keys → Create Key (Mail Send permission)
SENDGRID_API_KEY=
# Must be a verified sender in SendGrid (Settings → Sender Authentication)
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ── SMS OTP (Twilio) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional aliases also supported:
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────
# Meta Business Manager → WhatsApp Manager → API Setup. Sends are skipped
# (not an error) until both of these are set. Templates used are documented
# in docs/whatsapp-templates.md and must be approved in WhatsApp Manager
# under the exact same names before they'll send.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Copy these values directly from Stripe Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Copy this separately from Stripe Dashboard > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=
# Charge Stripe in GBP while app prices stay in PKR.
STRIPE_CHARGE_CURRENCY_CODE=GBP
# GBP per 1 PKR. Keep this updated, for example 0.0028 means 1000 PKR charges about 2.80 GBP.
STRIPE_PKR_TO_GBP_RATE=
# Optional fallback only. Package/business currency is used first.
STRIPE_PACKAGE_PAYMENT_CURRENCY_CODE=
STRIPE_PACKAGE_PAYMENT_APPLICATION_FEE_CENTS=0
# Test keys only: allow package Checkout on the platform account without salon Connect onboarding.
STRIPE_ALLOW_PLATFORM_PACKAGE_PAYMENTS_IN_TEST_MODE=false
# Default country used when creating a salon's Stripe Connect account.
STRIPE_CONNECT_COUNTRY_CODE=GB
SALON_ADMIN_PHONE=

# ── Location search / nearby-salon discovery ────────────────────────────
# When set, address search and reverse-geocoding use Mapbox (spec-preferred
# provider). Get a token from https://account.mapbox.com/access-tokens/.
# Falls back to the free Nominatim provider below when unset, so location
# search keeps working before you have a Mapbox token.
MAPBOX_ACCESS_TOKEN=
# LOCATION_SEARCH_PROVIDER_BASE_URL=https://nominatim.openstreetmap.org
# Comma-separated radii (km) nearby-salon search expands through until it
# finds enough results. Default: 5,10,20
# NEARBY_SALON_SEARCH_RADII_KM=5,10,20
# Minimum results before the radius stops expanding. Default: 3
# NEARBY_SALON_MIN_RESULTS=3

# ── Manual/offline payments (Easypaisa / JazzCash / Bank Transfer) ─────
# Each method's QR image + instructions are configured from /platform-admin
# (not env vars) so they can be edited without a restart/deploy.
# Where "verify this payment" admin notification emails are sent. Falls back
# to PUBLIC_SUPPORT_EMAIL if unset.
PLATFORM_PAYMENTS_ADMIN_EMAIL=
